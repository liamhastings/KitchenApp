    "check:logic": "tsc src/logic/rules.check.ts --ignoreConfig --outDir .tmp-check --module commonjs --target es2020 --moduleResolution node --skipLibCheck --esModuleInterop --types node --ignoreDeprecations 6.0 && node .tmp-check/logic/rules.check.js && rm -rf .tmp-check"
